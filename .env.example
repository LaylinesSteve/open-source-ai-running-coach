# ---- Passkey (required for /app) ----
# Shared secret users must enter to access the plan builder
PASSKEY=your_secret_passkey

# Optional: use a different secret for the cookie (defaults to PASSKEY)
# COOKIE_SECRET=

# ---- Strava (required for "Connect Strava" in plan form) ----
# Create app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
# For OAuth redirect - use your production URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://running.andersonventuregroup.com

# ---- AI (required for personalized plans from Strava) ----
# Get an API key at https://aistudio.google.com/app/apikey (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override model (default gemini-2.5-flash); e.g. gemini-3-flash-preview
# GEMINI_MODEL=gemini-2.5-flash

# ---- Storage (required for saving plans) ----
# Create a Redis database at https://upstash.com (free tier), then add:
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=your_token

# ---- Optional: your own tokens (for local use with existing plan) ----
# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=
