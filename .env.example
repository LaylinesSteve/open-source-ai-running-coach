# Strava API (create app at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# After OAuth with scope read,activity:read_all — paste the code exchange result here
# Access token expires in ~6 hours; use refresh_token to get a new one
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
